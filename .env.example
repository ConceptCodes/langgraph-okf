# OpenRouter API configuration
# Copy this file to .env and replace the API key with your own key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_APP_TITLE=LangGraph-OKF-Consumer
OPENROUTER_APP_URL=https://github.com/ConceptCodes/langgraph-okf

# OKF bundle configuration
BUNDLE_PATH=bundles/legal_sample
MIN_TRUST_TIER=unverified
MAX_TRAVERSAL_DEPTH=3
STRICT_VALIDATION=false
